# ═══════════════════════════════════════════════════════════
# Environment template — انسخ إلى .env أو اضبط في Vercel Dashboard
# ⚠️ لا تضع أي قيمة حقيقية هنا. هذا الملف يُتتبَّع في Git.
# ═══════════════════════════════════════════════════════════

# ─── Gemini (المساعد الذكي + إعادة الصياغة) ───
# يُضبَط في Vercel Environment Variables فقط
GEMINI_API_KEY=

# ─── أمان واجهات الذكاء الاصطناعي (security/api-hardening-phase1) ───
# قائمة الأصول المسموحة — Exact match، مفصولة بفواصل، بلا wildcard
# مثال: https://shouon-al-ghithaa.vercel.app,http://localhost:3001
ALLOWED_ORIGINS=

# تفعيل المصادقة الإلزامية على /api/agent و /api/rewrite
# true  = التوكن إلزامي (401 بدونه)
# غير true = وضع تطوير فقط — يمنعه Production Guard في الإنتاج
AI_REQUIRE_SUPABASE_JWT=false

# للتحقق من توكن Supabase (يُقرأ server-side فقط)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ─── Staging (اختياري — للاختبار السحابي لاحقًا) ───
STAGING_URL=
STAGING_ANON_KEY=
STAGING_PROJECT_REF=
STAGING_IS_PRODUCTION=false
