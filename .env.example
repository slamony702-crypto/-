# ═══════════════════════════════════════════════════════════
# Environment template — انسخ إلى .env.staging.local للاستخدام
# ⚠️ لا تضع القيم الحقيقية هنا. هذا الملف يُتتبَّع في Git.
# ═══════════════════════════════════════════════════════════

# ─── Supabase Staging ───
# لتفعيل التطبيق التلقائي على Cloud Staging، انسخ هذا الملف إلى
# .env.staging.local وضع القيم الحقيقية هناك (لن تُتتبَّع بسبب .gitignore).
STAGING_PROJECT_REF=              # مثل: abcdxyz1234
STAGING_URL=                      # https://<ref>.supabase.co
STAGING_REGION=                   # eu-central-1 مثلًا
STAGING_DB_HOST=                  # <ref>.supabase.co أو aws-0-<region>.pooler.supabase.com
STAGING_DB_PORT=5432              # 5432 (direct) أو 6543 (pooler)
STAGING_DB_NAME=postgres
STAGING_DB_USER=postgres          # أو postgres.<ref> عند استخدام pooler
STAGING_DB_PASSWORD=              # ⚠️ لا تُلصَق هنا نهائيًا — فقط في .env.staging.local
STAGING_IS_PRODUCTION=false       # تأكيد صريح أن البيئة اختبار

# Supabase CLI Access Token (للتطبيق التلقائي)
# استخرجه من https://supabase.com/dashboard/account/tokens
# ⚠️ token واحد يعطي وصولًا كاملًا لكل مشاريع الحساب — احذر
SUPABASE_ACCESS_TOKEN=

# ─── Anon key (public — للـUI) ───
# آمن نسبيًا للعرض، لكن يفضّل عدم مشاركته بلا حاجة
STAGING_ANON_KEY=

# ─── UI Override (للاختبار المحلي على staging) ───
# عند تفعيل هذا، UI يستخدم Staging بدل Production
# فعّله محليًا فقط — لا تُلصَق في localStorage الإنتاج
UI_STAGING_MODE=false

# ═══════════════════════════════════════════════════════════
# قيم Production (لا تُذكَر هنا — تُدار من Vercel Dashboard)
# ═══════════════════════════════════════════════════════════
# GEMINI_API_KEY — يُضبَط في Vercel Env Variables فقط
# ═══════════════════════════════════════════════════════════
